# Copy to .env (gitignored) and fill in. Never commit .env or paste keys into code or chat.

# Which brain plays Alexa: scripted (free, default) | openai | bedrock
SITUATION_GUARD_LLM=scripted

# OpenAI (only when SITUATION_GUARD_LLM=openai)
OPENAI_API_KEY=
SITUATION_GUARD_OPENAI_MODEL=gpt-5-mini
# How much the model thinks before answering: low is cheaper and faster. Values depend on the model; none = omit
SITUATION_GUARD_OPENAI_REASONING=low

# Amazon Bedrock (only when SITUATION_GUARD_LLM=bedrock) uses your AWS profile, no key here
SITUATION_GUARD_AWS_PROFILE=situation-guard
SITUATION_GUARD_BEDROCK_MODEL=global.amazon.nova-2-lite-v1:0

# Travel data: recorded (free, default) | live (Amazon Location, billed)
SITUATION_GUARD_TRAVEL=recorded

# Where the web demo reaches the MCP tools (the same /mcp any client uses)
SITUATION_GUARD_MCP_URL=http://127.0.0.1:8000/mcp

# Time zone for "now" in the web demo
SITUATION_GUARD_TIMEZONE=Australia/Sydney

# Weather (Open-Meteo, free for non-commercial use, CC BY 4.0): recorded (default) | live
SITUATION_GUARD_WEATHER=recorded
# Public holidays (Nager.Date, free for private/non-profit use): recorded (default) | live
SITUATION_GUARD_HOLIDAYS=recorded
# Place lookup: known (default, free) | live (Amazon Location Places, billed; needs geo-places:SearchText)
SITUATION_GUARD_PLACES=known
SITUATION_GUARD_PLACES_COUNTRY=AUS
# Calendar files (.ics) for import_calendar; default data/calendars
# SITUATION_GUARD_CALENDAR_DIR=
